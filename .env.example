# Local SQLite library. Demo mode uses a sibling `-demo` database file.
SPOTIFY_ANALYTICS_DATABASE_URL=sqlite:///./data/spotify-analytics.db
SPOTIFY_ANALYTICS_HOST=127.0.0.1
SPOTIFY_ANALYTICS_PORT=8000

# Set these only to enable Spotify OAuth and synchronization.
SPOTIFY_ANALYTICS_SPOTIFY_CLIENT_ID=
SPOTIFY_ANALYTICS_SPOTIFY_CLIENT_SECRET=
# Must exactly match the Spotify Developer Dashboard redirect URI.
SPOTIFY_ANALYTICS_REDIRECT_URI=http://127.0.0.1:8000/auth/callback
# Generate a private random value, e.g. `openssl rand -hex 32`.
SPOTIFY_ANALYTICS_SESSION_SECRET=
